NEXT_PUBLIC_SITE_URL=https://www.thepixelocracy.com

# Required for the /contact form to actually send email (src/app/api/contact/route.ts).
# Without these, the form still validates and submits, but the API route
# returns a clear "not configured" response instead of pretending to send.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
# Optional — defaults to "Pixelocracy <hello@thepixelocracy.com>" if unset.
CONTACT_FROM_EMAIL=
